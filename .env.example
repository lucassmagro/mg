# ============================================================================
# Variáveis de ambiente — copie para .env.local e preencha com as suas chaves.
# As chaves estão em: Supabase > Project Settings > API.
# ============================================================================

# URL do projeto (ex.: https://abcdxyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon / publishable). Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service_role) — SECRETA. Usada SOMENTE pelo script de seed
# (scripts/seed-supabase.mjs). NUNCA exponha no navegador / não commitar.
SUPABASE_SERVICE_ROLE_KEY=
